pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
x=64
y=64
walk_cnt = 0
spd = 2
sprite = 0
gnd = 100
function _update()
	if btn(0) then	
		x -= spd
		walk_cnt+=1
	end
	if btn(1) then	
		x += spd
		walk_cnt+=1
	end

	if(walk_cnt > 8) then
		walk_cnt = 0
		sprite+=1
	end
end

function _draw()
	cls()
	spr(sprite%2 , x, gnd) --sprite num: 0, 1
end
__gfx__
