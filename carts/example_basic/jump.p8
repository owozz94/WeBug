pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
a={y=100,dy=0}
grvt=0.8
function _update()
	if(btn(4)) then	a.dy=-6 end
	a.dy += grvt
	a.y += a.dy
	if(a.y>100) then 
		a.y=100 
		a.dy=-a.dy*0.8
	end
end

function _draw()
	cls()
	circfill(64,a.y,4,3)
end
__gfx__
