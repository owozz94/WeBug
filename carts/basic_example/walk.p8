pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
x=64
spd=1.2
seeleft=false
sprite=0

function _update()
	if btn(0) then
		seeleft=true
		x -= spd
	elseif btn(1) then
		seeleft=false
		x += spd
	end
	sprite = (x/8) % 2 -- x좌표를 8로 나눈값의 홀수짝수 에 따라 스프라이트를0,1로 바꿉니다.
end

function _draw()
	cls(13)	
	spr(sprite,  x,127-(20),  1,1, seeleft,false)
end
